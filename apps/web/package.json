{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate && node -e \"const fs=require('fs'); const path=require('path'); const src=path.resolve(__dirname,'../../node_modules/.prisma/client'); const dest=path.resolve(__dirname,'node_modules/@prisma/client/.prisma/client'); fs.mkdirSync(path.dirname(dest), {recursive:true}); fs.rmSync(dest, {recursive:true, force:true}); fs.cpSync(src, dest, {recursive:true, force:true});\"",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@collab-editor/shared-types": "workspace:*",
    "@prisma/client": "^5.20.0",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tiptap/extension-collaboration": "^3.30.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^5.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.6",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
