PORT=4000

# Redis (used starting Phase 12 for pub/sub scaling)
REDIS_URL="redis://localhost:6379"

# Must match apps/web's AUTH_SECRET so the realtime server can validate sessions
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collab_editor?schema=public"