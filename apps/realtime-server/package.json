{
  "name": "realtime-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint . --ext .ts",
    "prisma:generate": "prisma generate --schema=../web/prisma/schema.prisma",
    "postinstall": "prisma generate --schema=../web/prisma/schema.prisma"
  },
  "dependencies": {
    "@collab-editor/shared-types": "workspace:*",
    "@prisma/client": "^5.20.0",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.97",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
